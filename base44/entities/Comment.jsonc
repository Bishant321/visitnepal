{
  "name": "Comment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "Forum post ID"
    },
    "content": {
      "type": "string",
      "description": "Comment text"
    },
    "rating": {
      "type": "number",
      "description": "Rating 1-5 stars",
      "minimum": 1,
      "maximum": 5
    },
    "likes": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "post_id",
    "content"
  ]
}