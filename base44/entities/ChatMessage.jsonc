{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "Associated booking ID"
    },
    "experience_id": {
      "type": "string",
      "description": "Associated experience ID"
    },
    "group_chat_id": {
      "type": "string",
      "description": "Associated group chat ID"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of message sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of message sender"
    },
    "receiver_email": {
      "type": "string",
      "description": "Email of message receiver"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Message read status"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the message was read"
    },
    "attachment_url": {
      "type": "string",
      "description": "Optional file attachment"
    }
  },
  "required": [
    "sender_email",
    "sender_name",
    "receiver_email",
    "message"
  ]
}